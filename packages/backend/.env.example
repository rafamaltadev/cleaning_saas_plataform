# Application
NODE_ENV=development      # Environment: development | production | test
PORT=3000                 # HTTP server port

# Database (PostgreSQL)
DATABASE_HOST=localhost   # PostgreSQL host
DATABASE_PORT=5432        # PostgreSQL port
DATABASE_NAME=cleaning_saas  # Database name
DATABASE_USER=postgres    # Database user
DATABASE_PASSWORD=postgres   # Database password

# JWT Authentication
JWT_SECRET=replace_with_strong_secret               # Secret for signing access tokens
JWT_REFRESH_SECRET=replace_with_strong_refresh_secret  # Secret for signing refresh tokens
JWT_ACCESS_EXPIRATION=15m   # Access token expiration for admin/staff (e.g. 15m, 1h)
JWT_REFRESH_EXPIRATION=30d  # Refresh token expiration (e.g. 30d, 90d)
# Longer TTL for public clients — covers the full quote → scheduling flow without forcing re-auth
PUBLIC_CLIENT_TOKEN_EXPIRATION=60m

# CORS
FRONTEND_URL=http://localhost:5173  # Allowed frontend origin (no wildcard)

# Rate Limiting
THROTTLE_TTL=60000        # Global rate limit window in milliseconds
THROTTLE_LIMIT=100        # Global max requests per window per IP/user
THROTTLE_AUTH_TTL=60000   # Auth endpoint rate limit window in milliseconds
THROTTLE_AUTH_LIMIT=5     # Auth endpoint max requests per window (stricter)

# Seed (only required when running `npm run seed`)
SEED_DEFAULT_PASSWORD=replace_with_seed_password    # Password for seeded dev users (admin@seed.local, etc.)

# Storage (T17 — file uploads)
STORAGE_ADAPTER=local                     # Storage backend (only 'local' supported in Phase 2)
UPLOAD_DIR=uploads                        # Local storage path (relative to backend cwd)

# OAuth — Google (T20)
GOOGLE_OAUTH_CLIENT_ID=replace_with_google_client_id           # From Google Cloud Console
GOOGLE_OAUTH_CLIENT_SECRET=replace_with_google_client_secret   # From Google Cloud Console
GOOGLE_OAUTH_CALLBACK_URL=http://localhost:3000/api/v1/public  # Base path; slug appended per tenant

# OAuth — Facebook (T20)
FACEBOOK_OAUTH_APP_ID=replace_with_facebook_app_id             # From Facebook Developer Console
FACEBOOK_OAUTH_APP_SECRET=replace_with_facebook_app_secret     # From Facebook Developer Console
FACEBOOK_OAUTH_CALLBACK_URL=http://localhost:3000/api/v1/public  # Base path; slug appended per tenant
